{
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/og/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/cv/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "functions": {
    "api/community/changes.js": {
      "maxDuration": 60,
      "includeFiles": "{.generated/community-preview.mjs,src/index.css,src/project-artwork.css,src/community/community.css,public/fonts/**,public/images/**,public/img/**,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/community.js": {
      "maxDuration": 60,
      "includeFiles": "{.generated/community-preview.mjs,src/index.css,src/project-artwork.css,src/community/community.css,public/fonts/**,public/images/**,public/img/**,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/community/changes/*.js": {
      "maxDuration": 60,
      "includeFiles": "{.generated/community-preview.mjs,src/index.css,src/project-artwork.css,src/community/community.css,public/fonts/**,public/images/**,public/img/**,node_modules/@sparticuz/chromium/bin/**}"
    }
  },
  "crons": [
    {
      "path": "/api/community/maintenance",
      "schedule": "17 5 * * *"
    }
  ]
}
